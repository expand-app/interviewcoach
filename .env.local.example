# Required for all text analysis, coaching and scoring.
# Create a server-side key at https://platform.openai.com/api-keys
# Also used by the optional Retake OpenAI Realtime voice engine.
# Never prefix this variable with NEXT_PUBLIC_ or commit a real key.
OPENAI_API_KEY=

# Required for live speech recognition and the default Retake voice engine.
# Get yours from https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Optional — selects the Retake mock-interview voice engine:
#   "openai" -> OpenAI Realtime voice (requires Realtime access + billing)
#   unset / anything else -> Aura TTS + Deepgram STT + Luna text (default)
# This is read in the browser; changing it requires a rebuild.
NEXT_PUBLIC_RETAKE_ENGINE=
